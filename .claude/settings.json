{
  "permissions": {
    "allow": [
      "mcp__claude_ai_Render__create_static_site",
      "mcp__claude_ai_Render__update_environment_variables"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-gate.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/policy-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-on-edit.sh"
          }
        ]
      }
    ]
  }
}
