# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bookshelf
# Use the Supabase session pooler (port 5432) in production, never the
# transaction pooler (port 6543) — it breaks asyncpg's prepared statements.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Auth
GOOGLE_CLIENT_ID=           # Web client ID
GOOGLE_IOS_CLIENT_ID=       # iOS client ID (aud in tokens from iOS)
GOOGLE_ANDROID_CLIENT_ID=   # Android client ID (aud in tokens from Android)
GOOGLE_CLIENT_SECRET=
JWT_PRIVATE_KEY=       # RS256 private key (PEM format, single line with \n escapes)
JWT_PUBLIC_KEY=        # RS256 public key (PEM format, single line with \n escapes)
# Access-token lifetime in minutes (1..60). Replaces JWT_EXPIRY_HOURS, which
# is now ignored (boot logs a warning if it is still set).
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
# Seconds after a refresh-token rotation during which presenting the old token
# again counts as a client retry, not reuse (0..120, #690).
REFRESH_REUSE_GRACE_SECONDS=30
ALLOWED_EMAILS=you@example.com

# External APIs
# Claude, the only AI provider (#532, #538). Without it a scan answers
# 503 scan_unavailable; the app still boots.
ANTHROPIC_API_KEY=
# AI_ANTHROPIC_BASE_URL (#539): LEAVE UNSET. It points the Claude adapter at a
# local fake provider for the nightly load run (backend/perf/). Unset means
# https://api.anthropic.com. Only localhost / 127.0.0.1 / ::1 is accepted in any
# environment, and in staging and production ANY value stops the app from
# booting. (The generic ANTHROPIC_BASE_URL is deliberately ignored.)
# AI_ANTHROPIC_BASE_URL=http://127.0.0.1:18080
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Observability
SENTRY_DSN=          # optional — leave blank to disable Sentry

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
RATE_LIMIT_SCAN=10/minute
# Unverified library entries a user may hold (#616); 1..10000.
UNVERIFIED_BOOKS_PER_USER_MAX=200
# Days a deleted library entry stays in the trash before the daily purge (#683); 1..365.
TRASH_RETENTION_DAYS=30
# Most entries one user's trash holds, a backstop (one trashed copy per book is kept
# anyway); beyond it the oldest go first (#683); 100..5000.
TRASH_MAX_ENTRIES_PER_USER=1000
# Days the library audit log (library_events) keeps an event before the daily purge (#684); 1..730.
LIBRARY_EVENTS_RETENTION_DAYS=180
# Client IP trust: none (no proxy) | cloudflare (behind Cloudflare).
# Unset/empty = cloudflare when ENVIRONMENT is staging/production, else none.
TRUSTED_PROXY_MODE=
# Origin lockdown: leave empty locally (disabled). When set: >= 32 printable
# ASCII characters, e.g. `openssl rand -hex 32`.
ORIGIN_AUTH_SECRET=
# Reply-To on transactional email (Resend). Forwarded by Cloudflare Email
# Routing (#678). One bare address; blank = unset = this default.
EMAIL_REPLY_TO=support@buffingchi.com
# From address of transactional email: one bare address on the domain verified
# in Resend; sent as "Bookshelf <address>". Blank = this default.
EMAIL_FROM=noreply@mail.buffingchi.com
# Resend API key (secret). Empty = no email, so the account export is off.
RESEND_API_KEY=

# Account export (#694): a PRIVATE Supabase Storage bucket for the export
# files, reached with the project's service-role key (secret, server only).
# SUPABASE_URL or SUPABASE_SERVICE_ROLE_KEY (or RESEND_API_KEY) empty =
# POST /account/export answers 503 export_not_configured. Leave empty locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EXPORT_BUCKET=account-exports

# AI consent (#1023, Apple 5.1.2(i)): true = POST /scan refuses a user who has
# not agreed to scan photos going to the AI provider (403 ai_consent_required),
# before any count, quota or provider call. Rollout A: keep false until the app
# release that asks for consent is out, then turn it on (no code change).
AI_CONSENT_REQUIRED=false

# Device attestation on /scan (#753). See docs/RENDER.md "Enabling device
# attestation". All empty/false = off: /scan falls back to Turnstile.
ATTESTATION_REQUIRED=false
# HMAC secret for the stateless nonces (`openssl rand -hex 32`). Empty =
# /attestation/* answer 503 attestation_not_configured.
ATTESTATION_NONCE_SECRET=
# iOS App Attest: <TEAM_ID>.<BUNDLE_ID>. Empty = iOS registration 503, iOS
# assertions rejected.
ATTESTATION_APPLE_APP_ID=
# Also accept App Attest keys from the development environment (Xcode/debug
# builds, aaguid "appattestdevelop"), #1051. Keep false in production.
ATTESTATION_APPLE_ALLOW_DEVELOPMENT=false
# Android Play Integrity: package name and the service-account JSON (secret).
ATTESTATION_ANDROID_PACKAGE_NAME=
ATTESTATION_GOOGLE_CREDENTIALS_JSON=

# Scan kill switches and pixel cap: INITIAL DEFAULTS ONLY. They seed the
# ai_settings table on first boot; after that change them with
# `python -m app.ai.settings set <key> <value>` (see app/ai/settings/).
SCAN_ENABLED=true
SCAN_ENHANCED_ENABLED=true
# Decompression-bomb guard: max decoded pixels (width x height) per scan image.
SCAN_MAX_IMAGE_PIXELS=40000000   # 1000000..100000000
# Seconds each process (uvicorn worker) reuses the ai_settings rows it last
# read (processes may disagree for up to this long after a change).
AI_SETTINGS_CACHE_TTL_SECONDS=30 # 1..300
# When a read of ai_settings fails, the cached rows are still served while at
# most this old; past it, scans fail closed (503 ai_unavailable). Must be
# >= AI_SETTINGS_CACHE_TTL_SECONDS.
AI_SETTINGS_MAX_STALE_SECONDS=300 # 1..3600
# Scan allowances (#528). INITIAL DEFAULTS ONLY: they seed the ai_settings
# rows scan.global_daily_limit, quota.<tier>.found_daily and
# quota.<tier>.no_match_daily on first boot (#577);
# after that use `python -m app.ai.settings set <key> <value>`.
# There is no monthly allowance (#582); enhanced scans (Premium-only, #533)
# use the shared found allowance.
SCAN_GLOBAL_DAILY_LIMIT=2000      # 1..1000000, all users, per UTC day
SCAN_FREE_DAILY_LIMIT=5           # 0..1000, found scans per user per UTC day
SCAN_PREMIUM_DAILY_LIMIT=5        # 0..1000
SCAN_FREE_NO_MATCH_DAILY_LIMIT=5  # 0..1000, no-match scans per user per UTC day
SCAN_PREMIUM_NO_MATCH_DAILY_LIMIT=5 # 0..1000
# Cost circuit breaker (#531). INITIAL DEFAULT ONLY: seeds the ai_settings row
# breaker.free_daily_ceiling_micros. Service-wide AI spend per UTC day in
# micro-dollars (10000000 = $10) above which Free scans pause (503
# ai_budget_reached); Premium continues. 0 pauses every Free scan.
SCAN_FREE_DAILY_CEILING_MICROS=10000000 # 0..1000000000
# Image normalisations (decode + resize) running at once per process; bounds memory.
# Stays env: it sizes a limiter created at import.
SCAN_NORMALISE_CONCURRENCY=1     # 1..8
