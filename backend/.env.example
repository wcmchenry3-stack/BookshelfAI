# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bookshelf
# Use the Supabase session pooler (port 5432) in production, never the
# transaction pooler (port 6543) — it breaks asyncpg's prepared statements.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Auth
GOOGLE_CLIENT_ID=           # Web client ID
GOOGLE_IOS_CLIENT_ID=       # iOS client ID (aud in tokens from iOS)
GOOGLE_ANDROID_CLIENT_ID=   # Android client ID (aud in tokens from Android)
GOOGLE_CLIENT_SECRET=
JWT_PRIVATE_KEY=       # RS256 private key (PEM format, single line with \n escapes)
JWT_PUBLIC_KEY=        # RS256 public key (PEM format, single line with \n escapes)
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7
ALLOWED_EMAILS=you@example.com

# External APIs
OPENAI_API_KEY=
# Claude provider (#532). Only needed once a scan feature is switched to it:
#   python -m app.ai.settings switch scan.standard anthropic --by <you>
# (back: ... switch scan.standard openai). Without it such a feature answers
# 503 scan_unavailable; the app still boots.
ANTHROPIC_API_KEY=
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Observability
SENTRY_DSN=          # optional — leave blank to disable Sentry

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
RATE_LIMIT_SCAN=10/minute
# Client IP trust: none (no proxy) | cloudflare (behind Cloudflare).
# Unset/empty = cloudflare when ENVIRONMENT is staging/production, else none.
TRUSTED_PROXY_MODE=
# Origin lockdown: leave empty locally (disabled). When set: >= 32 printable
# ASCII characters, e.g. `openssl rand -hex 32`.
ORIGIN_AUTH_SECRET=

# Scan kill switches and pixel cap: INITIAL DEFAULTS ONLY. They seed the
# ai_settings table on first boot; after that change them with
# `python -m app.ai.settings set <key> <value>` (see app/ai/settings.py).
SCAN_ENABLED=true
SCAN_ENHANCED_ENABLED=true
# Decompression-bomb guard: max decoded pixels (width x height) per scan image.
SCAN_MAX_IMAGE_PIXELS=40000000   # 1000000..100000000
# Seconds each process (uvicorn worker) reuses the ai_settings rows it last
# read (processes may disagree for up to this long after a change).
AI_SETTINGS_CACHE_TTL_SECONDS=30 # 1..300
# When a read of ai_settings fails, the cached rows are still served while at
# most this old; past it, scans fail closed (503 ai_unavailable). Must be
# >= AI_SETTINGS_CACHE_TTL_SECONDS.
AI_SETTINGS_MAX_STALE_SECONDS=300 # 1..3600
# Scan allowances (#528). INITIAL DEFAULTS ONLY: they seed the ai_settings
# rows scan.global_daily_limit and quota.<tier>.daily / .monthly on first boot;
# after that use `python -m app.ai.settings set <key> <value>`.
SCAN_GLOBAL_DAILY_LIMIT=2000      # 1..1000000, all users, per UTC day
SCAN_FREE_DAILY_LIMIT=5           # 0..1000, per user per UTC day
SCAN_FREE_MONTHLY_LIMIT=5         # 0..100000, per user per UTC month
SCAN_PREMIUM_DAILY_LIMIT=30       # 0..1000
SCAN_PREMIUM_MONTHLY_LIMIT=300    # 0..100000
# Legacy (#509): no longer applied to /scan; removed in #540.
SCAN_DAILY_LIMIT_PER_USER=20      # 1..1000
# Image normalisations (decode + resize) running at once per process; bounds memory.
# Stays env: it sizes a limiter created at import.
SCAN_NORMALISE_CONCURRENCY=1     # 1..8
