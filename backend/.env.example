# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bookshelf
# Use the Supabase session pooler (port 5432) in production, never the
# transaction pooler (port 6543) — it breaks asyncpg's prepared statements.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Auth
GOOGLE_CLIENT_ID=           # Web client ID
GOOGLE_IOS_CLIENT_ID=       # iOS client ID (aud in tokens from iOS)
GOOGLE_ANDROID_CLIENT_ID=   # Android client ID (aud in tokens from Android)
GOOGLE_CLIENT_SECRET=
JWT_PRIVATE_KEY=       # RS256 private key (PEM format, single line with \n escapes)
JWT_PUBLIC_KEY=        # RS256 public key (PEM format, single line with \n escapes)
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7
ALLOWED_EMAILS=you@example.com

# External APIs
OPENAI_API_KEY=
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Observability
SENTRY_DSN=          # optional — leave blank to disable Sentry

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081
RATE_LIMIT_SCAN=10/minute
